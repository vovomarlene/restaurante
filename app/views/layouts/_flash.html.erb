<div id="flash" class="no-print">
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-4 text-green-700 font-medium rounded-lg" id="notice"><%= notice %></p>
  <% end %>

  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-4 text-red-700 font-medium rounded-lg" id="alert"><%= alert %></p>
  <% end %>
</div>
