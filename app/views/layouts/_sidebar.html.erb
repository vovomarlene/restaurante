<aside class="w-56 shrink-0 bg-primary-700 text-white flex flex-col h-screen sticky top-0 self-start">
  <div class="px-4 py-4 border-b border-primary-600 shrink-0">
    <%= link_to t("app.name"), root_path, class: "font-bold text-lg tracking-tight block" %>
  </div>

  <nav class="flex-1 min-h-0 overflow-y-auto px-3 py-4 space-y-1 text-sm">
    <%= link_to tables_path,
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(tables_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
      <%= icon :tables %> Mesas
    <% end %>
    <%= link_to balcao_path,
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(balcao_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
      <%= icon :balcao %> Balcão
    <% end %>
    <%= link_to deliveries_path,
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(deliveries_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
      <%= icon :delivery %> Delivery
    <% end %>
    <%= link_to customers_path,
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(customers_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
      <%= icon :customers %> Clientes
    <% end %>
    <%= link_to orders_path,
          class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(orders_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
      <%= icon :sales %> Vendas
    <% end %>

    <% if current_user_admin? %>
      <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-primary-300">Administração</p>
      <%= link_to admin_categories_path,
            class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(admin_categories_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
        <%= icon :category %> Categorias
      <% end %>
      <%= link_to admin_products_path,
            class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(admin_products_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
        <%= icon :product %> Produtos
      <% end %>
      <%= link_to admin_ingredients_path,
            class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(admin_ingredients_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
        <%= icon :ingredient %> Insumos
      <% end %>
      <%= link_to admin_dining_tables_path,
            class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(admin_dining_tables_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
        <%= icon :admin_tables %> Cadastro de mesas
      <% end %>
      <%= link_to admin_reports_path,
            class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(admin_reports_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
        <%= icon :report %> Relatórios
      <% end %>
      <%= link_to edit_admin_setting_path,
            class: "flex items-center gap-2.5 px-3 py-2 rounded-md hover:bg-primary-800 hover:text-white #{current_page?(edit_admin_setting_path) ? "bg-primary-800 text-white" : "text-primary-100"}" do %>
        <%= icon :settings %> Configurações
      <% end %>
    <% end %>
  </nav>

  <div class="px-3 py-4 border-t border-primary-600 space-y-3 shrink-0">
    <% if CashSession.current %>
      <%= link_to cash_session_path, class: "flex items-center justify-center gap-1.5 text-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 hover:bg-green-200" do %>
        <%= icon :cash, css_class: "size-3.5" %> Caixa aberto
      <% end %>
    <% else %>
      <%= link_to new_cash_session_path, class: "flex items-center justify-center gap-1.5 text-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 hover:bg-red-200" do %>
        <%= icon :cash, css_class: "size-3.5" %> Caixa fechado
      <% end %>
    <% end %>

    <div class="text-primary-100 text-xs">
      <%= Current.user.name %>
      <span class="text-primary-300">·</span>
      <%= t("enums.user.role.#{Current.user.role}") %>
    </div>

    <%= button_to session_path, method: :delete, class: "w-full flex items-center justify-center gap-2 bg-primary-800 hover:bg-primary-900 px-3 py-1.5 rounded-md cursor-pointer text-sm" do %>
      <%= icon :logout, css_class: "size-4" %> <%= t("nav.logout") %>
    <% end %>
  </div>
</aside>
