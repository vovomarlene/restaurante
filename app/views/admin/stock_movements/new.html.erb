<% content_for :title, "Novo movimento — #{@ingredient.name}" %>

<h1 class="font-bold text-2xl mb-6">Novo movimento — <%= @ingredient.name %></h1>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6 max-w-md">
  <%= form_with url: admin_ingredient_stock_movements_path(@ingredient), scope: :stock_movement, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :direction, "Tipo", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.select :direction, [["Entrada (compra/reposição)", "entrada"], ["Saída (perda/quebra/ajuste)", "saida"]], {}, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :quantity, "Quantidade (#{@ingredient.unit})", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.number_field :quantity, step: "0.001", min: "0", class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :reason, "Motivo", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.text_field :reason, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div class="flex gap-3">
      <%= form.submit "Registrar", class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
      <%= link_to "Cancelar", admin_ingredient_stock_movements_path(@ingredient), class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted" %>
    </div>
  <% end %>
</div>
