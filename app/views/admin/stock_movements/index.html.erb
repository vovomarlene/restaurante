<% content_for :title, "Movimentações — #{@ingredient.name}" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="font-bold text-2xl"><%= @ingredient.name %></h1>
    <p class="text-ink-muted text-sm">Estoque atual: <%= @ingredient.current_stock %> <%= @ingredient.unit %></p>
  </div>
  <div class="flex gap-3">
    <%= link_to "Novo movimento", new_admin_ingredient_stock_movement_path(@ingredient), class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium" %>
    <%= link_to "Voltar para insumos", admin_ingredients_path, class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted font-medium" %>
  </div>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-2">Data</th>
        <th class="px-4 py-2">Origem</th>
        <th class="px-4 py-2">Quantidade</th>
        <th class="px-4 py-2">Saldo após</th>
        <th class="px-4 py-2">Motivo</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @stock_movements.each do |movement| %>
        <tr>
          <td class="px-4 py-2"><%= l(movement.created_at, format: :short) %></td>
          <td class="px-4 py-2"><%= t("enums.stock_movement.origin.#{movement.origin}") %></td>
          <td class="px-4 py-2 <%= movement.quantity.negative? ? "text-danger" : "text-success" %>">
            <%= movement.quantity.positive? ? "+" : "" %><%= movement.quantity %>
          </td>
          <td class="px-4 py-2"><%= movement.balance_after %></td>
          <td class="px-4 py-2 text-ink-muted"><%= movement.reason %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
