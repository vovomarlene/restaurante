<% content_for :title, "Categorias" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :category, css_class: "size-6 text-primary-700" %> Categorias</h1>
  <%= link_to "Nova categoria", new_admin_category_path, class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium" %>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-2">Nome</th>
        <th class="px-4 py-2">Posição</th>
        <th class="px-4 py-2">Ativa</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @categories.each do |category| %>
        <tr class="hover:bg-surface-muted transition-colors">
          <td class="px-4 py-2"><%= category.name %></td>
          <td class="px-4 py-2"><%= category.position %></td>
          <td class="px-4 py-2"><%= category.active? ? "Sim" : "Não" %></td>
          <td class="px-4 py-2 text-right space-x-3">
            <%= link_to "Editar", edit_admin_category_path(category), class: "text-primary-700 hover:underline" %>
            <%= button_to "Remover", admin_category_path(category), method: :delete, class: "text-danger hover:underline bg-transparent border-0 p-0 cursor-pointer font-normal", form: { data: { turbo_confirm: "Remover esta categoria?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
