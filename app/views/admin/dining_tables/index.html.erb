<% content_for :title, "Mesas" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-2xl">Mesas</h1>
  <%= link_to "Nova mesa", new_admin_dining_table_path, class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium" %>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-2">Número</th>
        <th class="px-4 py-2">Capacidade</th>
        <th class="px-4 py-2">Status</th>
        <th class="px-4 py-2">Ativa</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @dining_tables.each do |table| %>
        <tr class="hover:bg-surface-muted transition-colors">
          <td class="px-4 py-2">Mesa <%= table.number %></td>
          <td class="px-4 py-2"><%= table.capacity %></td>
          <td class="px-4 py-2">
            <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= table.livre? ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800" %>">
              <%= table.livre? ? "Livre" : "Ocupada" %>
            </span>
          </td>
          <td class="px-4 py-2"><%= table.active? ? "Sim" : "Não" %></td>
          <td class="px-4 py-2 text-right space-x-3">
            <%= link_to "Editar", edit_admin_dining_table_path(table), class: "text-primary-700 hover:underline" %>
            <%= button_to "Remover", admin_dining_table_path(table), method: :delete, class: "text-danger hover:underline bg-transparent border-0 p-0 cursor-pointer font-normal", form: { data: { turbo_confirm: "Remover esta mesa?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
