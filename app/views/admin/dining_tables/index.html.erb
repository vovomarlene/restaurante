<% content_for :title, "Mesas" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :admin_tables, css_class: "size-6 text-primary-700" %> Mesas</h1>
  <%= link_to new_admin_dining_table_path, class: "inline-flex items-center gap-1.5 rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium" do %>
    <%= icon :plus, css_class: "size-4" %> Nova mesa
  <% end %>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Número</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Capacidade</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Status</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Ativa</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @dining_tables.empty? %>
        <tr><td class="px-4 py-6 text-center text-ink-muted" colspan="5">Nenhuma mesa cadastrada.</td></tr>
      <% end %>
      <% @dining_tables.each do |table| %>
        <tr class="hover:bg-surface-muted transition-colors">
          <td class="px-4 py-3 font-medium">Mesa <%= table.number %></td>
          <td class="px-4 py-3"><%= table.capacity %></td>
          <td class="px-4 py-3">
            <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= table.livre? ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800" %>">
              <%= table.livre? ? "Livre" : "Ocupada" %>
            </span>
          </td>
          <td class="px-4 py-3"><%= active_badge(table.active?) %></td>
          <td class="px-4 py-3 text-right space-x-1">
            <%= link_to edit_admin_dining_table_path(table), class: "inline-flex items-center gap-1 text-primary-700 hover:bg-primary-50 rounded-md px-2 py-1" do %>
              <%= icon :edit, css_class: "size-4" %> Editar
            <% end %>
            <%= button_to admin_dining_table_path(table), method: :delete, class: "inline-flex items-center gap-1 text-danger hover:bg-red-50 rounded-md px-2 py-1 bg-transparent border-0 cursor-pointer font-normal", form: { data: { turbo_confirm: "Remover esta mesa?" } } do %>
              <%= icon :trash, css_class: "size-4" %> Remover
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
