<% content_for :title, "Relatórios" %>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :report, css_class: "size-6 text-primary-700" %> Relatórios</h1>

  <%= form_with url: admin_reports_path, method: :get, class: "flex items-center gap-2 flex-wrap" do |form| %>
    <%= form.label :period, "Período", class: "text-sm text-ink-muted" %>
    <%= form.select :period, [["Diário", "diario"], ["Semanal", "semanal"], ["Mensal", "mensal"]],
          { selected: @period }, class: "shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-1.5 text-sm" %>

    <%= form.label :date, "Data de referência", class: "text-sm text-ink-muted" %>
    <%= form.text_field :date, value: @date.strftime("%d/%m/%Y"), placeholder: "dd/mm/aaaa", pattern: "\\d{2}/\\d{2}/\\d{4}",
          class: "shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-1.5 text-sm w-28" %>
    <%= form.submit "Ver", class: "rounded-md px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium cursor-pointer" %>
  <% end %>
</div>

<div class="grid md:grid-cols-2 gap-6 mb-6">
  <% period_label = { "diario" => "do dia", "semanal" => "da semana", "mensal" => "do mês" }[@period] %>
  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-lg mb-1">Vendas <%= period_label %></h2>
    <p class="text-3xl font-bold text-primary-700 mb-4"><%= number_to_currency(@total_sales, unit: "R$", separator: ",", delimiter: ".") %></p>

    <h3 class="text-sm font-medium text-ink-muted mb-2">Por forma de pagamento</h3>
    <% if @sales_by_method.empty? %>
      <p class="text-ink-muted text-sm">Nenhuma venda no período.</p>
    <% else %>
      <ul class="text-sm divide-y divide-gray-100 mb-4">
        <% @sales_by_method.each do |method, amount| %>
          <li class="py-1.5 flex justify-between">
            <span><%= t("enums.payment.method.#{method}") %></span>
            <span class="font-medium"><%= number_to_currency(amount, unit: "R$", separator: ",", delimiter: ".") %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <h3 class="text-sm font-medium text-ink-muted mb-2">Por tipo de venda</h3>
    <% if @sales_by_order_type.empty? %>
      <p class="text-ink-muted text-sm">—</p>
    <% else %>
      <ul class="text-sm divide-y divide-gray-100">
        <% @sales_by_order_type.each do |order_type, amount| %>
          <li class="py-1.5 flex justify-between">
            <span><%= t("enums.order.order_type.#{order_type}") %></span>
            <span class="font-medium"><%= number_to_currency(amount, unit: "R$", separator: ",", delimiter: ".") %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-lg mb-3">Produtos mais vendidos</h2>
    <% if @top_products.empty? %>
      <p class="text-ink-muted text-sm">Nenhuma venda no período.</p>
    <% else %>
      <ul class="text-sm divide-y divide-gray-100">
        <% @top_products.each do |name, quantity| %>
          <li class="py-1.5 flex justify-between">
            <span><%= name %></span>
            <span class="font-medium"><%= quantity.to_i %> un.</span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
  <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
    <h2 class="font-semibold text-lg flex items-center gap-2"><%= icon :customers, css_class: "size-5 text-primary-700" %> Fiado <%= period_label %>, por cliente</h2>
    <%= link_to admin_reports_path(period: @period, date: @date.strftime("%d/%m/%Y"), only_owing: @only_owing ? nil : 1),
          class: "text-sm rounded-md px-3 py-1.5 border #{@only_owing ? "bg-primary-600 text-white border-primary-600" : "border-gray-300 hover:bg-surface-muted"}" do %>
      Mostrar só quem ainda deve
    <% end %>
  </div>

  <% if @fiado_report.empty? %>
    <p class="text-ink-muted text-sm">Nenhuma movimentação de fiado no período<%= " entre quem ainda deve" if @only_owing %>.</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-ink-muted">
          <tr>
            <th class="py-1.5 pr-2">Cliente</th>
            <th class="py-1.5 pr-2 text-right">Comprou no período</th>
            <th class="py-1.5 pr-2 text-right">Quitou no período</th>
            <th class="py-1.5 text-right">Saldo devedor atual</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @fiado_report.each do |row| %>
            <tr>
              <td class="py-1.5 pr-2">
                <%= link_to row[:customer].name, customer_path(row[:customer]), class: "text-primary-700 hover:underline" %>
              </td>
              <td class="py-1.5 pr-2 text-right"><%= number_to_currency(row[:purchased], unit: "R$", separator: ",", delimiter: ".") %></td>
              <td class="py-1.5 pr-2 text-right text-success"><%= number_to_currency(row[:settled], unit: "R$", separator: ",", delimiter: ".") %></td>
              <td class="py-1.5 text-right font-medium <%= "text-danger" if row[:balance].positive? %>">
                <%= number_to_currency(row[:balance], unit: "R$", separator: ",", delimiter: ".") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<div class="grid md:grid-cols-2 gap-6">
  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-lg mb-3">Estoque baixo</h2>
    <% if @low_stock_ingredients.empty? %>
      <p class="text-ink-muted text-sm">Nenhum insumo abaixo do mínimo.</p>
    <% else %>
      <ul class="text-sm divide-y divide-gray-100">
        <% @low_stock_ingredients.each do |ingredient| %>
          <li class="py-1.5 flex justify-between">
            <span><%= ingredient.name %></span>
            <span class="font-medium text-danger"><%= ingredient.current_stock %> / mín. <%= ingredient.min_stock %> <%= ingredient.unit %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-lg mb-3">Histórico de caixa</h2>
    <% if @cash_sessions.empty? %>
      <p class="text-ink-muted text-sm">Nenhum caixa fechado ainda.</p>
    <% else %>
      <table class="w-full text-left text-sm">
        <thead class="text-ink-muted">
          <tr>
            <th class="py-1.5 pr-2">Fechado em</th>
            <th class="py-1.5 pr-2">Operador</th>
            <th class="py-1.5 text-right">Diferença</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @cash_sessions.each do |session| %>
            <tr>
              <td class="py-1.5 pr-2"><%= l(session.closed_at, format: :short) %></td>
              <td class="py-1.5 pr-2"><%= session.closed_by.name %></td>
              <td class="py-1.5 text-right font-medium <%= session.difference_amount.negative? ? "text-danger" : "text-success" %>">
                <%= session.difference_amount.negative? ? "-" : "+" %><%= number_to_currency(session.difference_amount.abs, unit: "R$", separator: ",", delimiter: ".") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
