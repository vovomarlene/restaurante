<% content_for :title, "Impressoras" %>
<% content_for :head do %>
  <%= javascript_include_tag "qz-tray", "data-turbo-track": "reload" %>
<% end %>

<h1 class="font-bold text-2xl mb-2">Impressoras</h1>
<p class="text-ink-muted text-sm mb-6">
  Digite exatamente o nome da impressora como ela aparece no sistema (Linux/CUPS), ou use "Detectar impressoras"
  se o QZ Tray já estiver aberto neste computador.
</p>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6 max-w-lg" data-controller="printer-detect">
  <%= render "form", printer_setting: @printer_setting %>
</div>
