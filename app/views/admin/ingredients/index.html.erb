<% content_for :title, "Insumos" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :ingredient, css_class: "size-6 text-primary-700" %> Insumos</h1>
  <%= link_to new_admin_ingredient_path, class: "inline-flex items-center gap-1.5 rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium" do %>
    <%= icon :plus, css_class: "size-4" %> Novo insumo
  <% end %>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Nome</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Unidade</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Estoque atual</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Estoque mínimo</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Ativo</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @ingredients.empty? %>
        <tr><td class="px-4 py-6 text-center text-ink-muted" colspan="6">Nenhum insumo cadastrado.</td></tr>
      <% end %>
      <% @ingredients.each do |ingredient| %>
        <tr class="hover:bg-surface-muted transition-colors <%= "bg-red-50 hover:bg-red-100" if ingredient.current_stock <= ingredient.min_stock %>">
          <td class="px-4 py-3 font-medium">
            <%= ingredient.name %>
            <% if ingredient.current_stock <= ingredient.min_stock %>
              <%= icon :warning, css_class: "size-3.5 text-danger inline align-text-top" %>
            <% end %>
          </td>
          <td class="px-4 py-3 text-ink-muted"><%= ingredient.unit %></td>
          <td class="px-4 py-3"><%= ingredient.current_stock %></td>
          <td class="px-4 py-3 text-ink-muted"><%= ingredient.min_stock %></td>
          <td class="px-4 py-3"><%= active_badge(ingredient.active?) %></td>
          <td class="px-4 py-3 text-right space-x-1">
            <%= link_to admin_ingredient_stock_movements_path(ingredient), class: "inline-flex items-center gap-1 text-primary-700 hover:bg-primary-50 rounded-md px-2 py-1" do %>
              <%= icon :clipboard, css_class: "size-4" %> Movimentações
            <% end %>
            <%= link_to edit_admin_ingredient_path(ingredient), class: "inline-flex items-center gap-1 text-primary-700 hover:bg-primary-50 rounded-md px-2 py-1" do %>
              <%= icon :edit, css_class: "size-4" %> Editar
            <% end %>
            <%= button_to admin_ingredient_path(ingredient), method: :delete, class: "inline-flex items-center gap-1 text-danger hover:bg-red-50 rounded-md px-2 py-1 bg-transparent border-0 cursor-pointer font-normal", form: { data: { turbo_confirm: "Remover este insumo?" } } do %>
              <%= icon :trash, css_class: "size-4" %> Remover
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
