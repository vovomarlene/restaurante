<%= form_with model: [:admin, ingredient], class: "space-y-4" do |form| %>
  <% if ingredient.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-700 rounded-lg text-sm">
      <%= ingredient.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nome", class: "block text-sm font-medium text-ink-muted mb-1" %>
    <%= form.text_field :name, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
  </div>

  <div>
    <%= form.label :unit, "Unidade", class: "block text-sm font-medium text-ink-muted mb-1" %>
    <%= form.select :unit, Ingredient.units.keys.map { |u| [u, u] }, {}, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
  </div>

  <% if ingredient.new_record? %>
    <div>
      <%= form.label :current_stock, "Estoque inicial", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.number_field :current_stock, step: "0.001", class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>
  <% end %>

  <div>
    <%= form.label :min_stock, "Estoque mínimo", class: "block text-sm font-medium text-ink-muted mb-1" %>
    <%= form.number_field :min_stock, step: "0.001", class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :active, class: "rounded border-gray-300" %>
    <%= form.label :active, "Ativo", class: "text-sm font-medium text-ink-muted" %>
  </div>

  <div class="flex gap-3">
    <%= form.submit "Salvar", class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancelar", admin_ingredients_path, class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted" %>
  </div>
<% end %>
