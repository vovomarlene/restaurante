<% content_for :title, "Produtos" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :product, css_class: "size-6 text-primary-700" %> Produtos</h1>
  <%= link_to new_admin_product_path, class: "inline-flex items-center gap-1.5 rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium" do %>
    <%= icon :plus, css_class: "size-4" %> Novo produto
  <% end %>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Nome</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Categoria</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Preço</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Ficha técnica</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Ativo</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @products.empty? %>
        <tr><td class="px-4 py-6 text-center text-ink-muted" colspan="6">Nenhum produto cadastrado.</td></tr>
      <% end %>
      <% @products.each do |product| %>
        <tr class="hover:bg-surface-muted transition-colors">
          <td class="px-4 py-3 font-medium"><%= product.name %></td>
          <td class="px-4 py-3 text-ink-muted"><%= product.category.name %></td>
          <td class="px-4 py-3"><%= number_to_currency(product.price, unit: "R$", separator: ",", delimiter: ".") %></td>
          <td class="px-4 py-3 text-ink-muted"><%= product.recipe_items.size %> insumo(s)</td>
          <td class="px-4 py-3"><%= active_badge(product.active?) %></td>
          <td class="px-4 py-3 text-right space-x-1">
            <%= link_to edit_admin_product_path(product), class: "inline-flex items-center gap-1 text-primary-700 hover:bg-primary-50 rounded-md px-2 py-1" do %>
              <%= icon :edit, css_class: "size-4" %> Editar
            <% end %>
            <%= button_to admin_product_path(product), method: :delete, class: "inline-flex items-center gap-1 text-danger hover:bg-red-50 rounded-md px-2 py-1 bg-transparent border-0 cursor-pointer font-normal", form: { data: { turbo_confirm: "Remover este produto?" } } do %>
              <%= icon :trash, css_class: "size-4" %> Remover
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
