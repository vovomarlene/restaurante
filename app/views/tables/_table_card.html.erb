<div id="<%= dom_id(table) %>" class="rounded-xl border p-4 text-center <%= table.livre? ? "bg-green-50 border-green-300" : "bg-red-50 border-red-300" %>">
  <p class="font-bold text-lg">Mesa <%= table.number %></p>
  <p class="text-sm text-ink-muted"><%= table.capacity %> lugares</p>
  <p class="text-xs font-medium mt-1 <%= table.livre? ? "text-green-700" : "text-red-700" %>">
    <%= table.livre? ? "Livre" : "Ocupada" %>
  </p>

  <% if table.livre? %>
    <%= button_to "Abrir mesa", orders_path(order: { order_type: "mesa", dining_table_id: table.id }), method: :post,
          class: "mt-3 w-full rounded-md px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium cursor-pointer" %>
  <% elsif order = table.open_order %>
    <%= link_to "Ver comanda", order_path(order),
          class: "mt-3 inline-block w-full rounded-md px-3 py-1.5 bg-surface border border-gray-300 hover:bg-surface-muted text-sm font-medium" %>
  <% end %>
</div>
