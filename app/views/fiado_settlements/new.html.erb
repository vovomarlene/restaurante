<% content_for :title, "Registrar pagamento — #{@customer.name}" %>

<h1 class="font-bold text-2xl mb-2">Registrar pagamento</h1>
<p class="text-ink-muted text-sm mb-6">
  <%= @customer.name %> — saldo devedor: <%= number_to_currency(@customer.fiado_balance, unit: "R$ ", separator: ",", delimiter: ".") %>
</p>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6 max-w-md">
  <%= form_with model: @settlement, url: customer_fiado_settlements_path(@customer), class: "space-y-4" do |form| %>
    <% if @settlement.errors.any? %>
      <div class="py-2 px-3 bg-red-50 text-red-700 rounded-lg text-sm">
        <%= @settlement.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :method, "Forma de pagamento", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.select :method,
            [["Dinheiro", "dinheiro"], ["Cartão de débito", "cartao_debito"], ["Cartão de crédito", "cartao_credito"], ["PIX", "pix"]],
            {}, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :amount, "Valor (R$)", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.number_field :amount, step: "0.01", class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div>
      <%= form.label :notes, "Observações (opcional)", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.text_field :notes, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div class="flex gap-3">
      <%= form.submit "Registrar", class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
      <%= link_to "Cancelar", customer_path(@customer), class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted" %>
    </div>
  <% end %>
</div>
