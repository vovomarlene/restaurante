<% content_for :title, "Comandas" %>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :tables, css_class: "size-6 text-primary-700" %> Comandas</h1>
  <%= button_to "Nova comanda", orders_path(order: { order_type: "mesa" }), method: :post,
        class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
</div>

<% if @orders.empty? %>
  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-8 text-center text-ink-muted">
    <%= icon :tables, css_class: "size-8 mx-auto mb-3 text-ink-muted/60" %>
    <p>Nenhuma comanda em aberto no momento.</p>
    <p class="text-sm mt-1">Clique em "Nova comanda" para atender uma mesa.</p>
  </div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <% @orders.each do |order| %>
      <%= render "order_card", order: order %>
    <% end %>
  </div>
<% end %>
