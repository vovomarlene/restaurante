<% content_for :title, "Abrir caixa" %>

<h1 class="font-bold text-2xl mb-6">Abrir caixa</h1>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6 max-w-md">
  <%= form_with model: @cash_session, url: cash_session_path, class: "space-y-4" do |form| %>
    <% if @cash_session.errors.any? %>
      <div class="py-2 px-3 bg-red-50 text-red-700 rounded-lg text-sm">
        <%= @cash_session.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :opening_amount, "Fundo de troco inicial em dinheiro (R$)", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.number_field :opening_amount, step: "0.01", min: 0, required: true, placeholder: "0,00",
            class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
      <p class="text-xs text-ink-muted mt-1">Quanto tem em dinheiro na gaveta ao abrir o caixa. Pode ser 0.</p>
    </div>

    <div>
      <%= form.label :opening_notes, "Observações (opcional)", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.text_area :opening_notes, rows: 2, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <%= form.submit "Abrir caixa", class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
  <% end %>
</div>
