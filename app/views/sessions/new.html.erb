<div class="mx-auto w-full max-w-sm mt-16">
  <h1 class="font-bold text-3xl text-center mb-8 text-primary-700"><%= t("app.name") %></h1>

  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-xl mb-6"><%= t("session.new.title") %></h2>

    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, t("session.new.email_address"), class: "block text-sm font-medium text-ink-muted mb-1" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :password, t("session.new.password"), class: "block text-sm font-medium text-ink-muted mb-1" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
      </div>

      <%= form.submit t("session.new.submit"), class: "w-full text-center rounded-md px-3.5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>

      <div class="text-center text-sm">
        <%= link_to t("session.new.forgot_password"), new_password_path, class: "text-ink-muted underline hover:no-underline" %>
      </div>
    <% end %>
  </div>
</div>
