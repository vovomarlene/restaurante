<% content_for :title, "Corrigir pagamento" %>

<h1 class="font-bold text-2xl mb-2">Corrigir pagamento — Comanda #<%= @order.id %></h1>
<p class="text-ink-muted text-sm mb-6">
  Só a forma de pagamento pode ser corrigida aqui — o valor (<%= number_to_currency(@payment.amount, unit: "R$", separator: ",", delimiter: ".") %>) não muda.
</p>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6 max-w-md">
  <% if @payment.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-700 rounded-lg text-sm mb-3">
      <%= @payment.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form_with model: @payment, url: order_payment_path(@order, @payment), method: :patch, class: "space-y-4", data: { controller: "payment-method" } do |form| %>
    <div>
      <%= form.label :method, "Forma de pagamento", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.select :method,
            [["Dinheiro", "dinheiro"], ["Cartão de débito", "cartao_debito"], ["Cartão de crédito", "cartao_credito"], ["PIX", "pix"], ["Fiado", "fiado"]],
            {}, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full",
            data: { action: "payment-method#toggle" } %>
    </div>

    <div>
      <%= form.label :amount_received, "Valor recebido em dinheiro (para calcular troco)", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.number_field :amount_received, step: "0.01", class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div data-payment-method-target="customerField" class="<%= "hidden" unless @payment.fiado? %>">
      <%= form.label :customer_id, "Cliente (fiado)", class: "block text-sm font-medium text-ink-muted mb-1" %>
      <%= form.collection_select :customer_id, Customer.active, :id, :name, { include_blank: "Selecione o cliente" },
            class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
    </div>

    <div class="flex gap-3">
      <%= form.submit "Salvar correção", class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
      <%= link_to "Cancelar", order_path(@order), class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted" %>
    </div>
  <% end %>
</div>
