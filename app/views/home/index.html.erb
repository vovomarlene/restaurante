<% content_for :title, t("app.name") %>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
  <h1 class="font-bold text-2xl mb-1">Olá, <%= Current.user.name %></h1>
  <p class="text-ink-muted">Resumo do dia e atalhos rápidos para o dia a dia do restaurante.</p>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex items-center gap-2 text-ink-muted text-sm mb-1">
      <%= icon :sales, css_class: "size-4" %> Vendas hoje
    </div>
    <p class="font-bold text-2xl"><%= number_to_currency(@sales_today_total, unit: "R$ ", separator: ",", delimiter: ".") %></p>
    <p class="text-xs text-ink-muted"><%= pluralize(@sales_today_count, "venda fechada", plural: "vendas fechadas") %></p>
  </div>

  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex items-center gap-2 text-ink-muted text-sm mb-1">
      <%= icon :cash, css_class: "size-4" %> Caixa
    </div>
    <% if @cash_session %>
      <p class="font-bold text-2xl text-success">Aberto</p>
      <p class="text-xs text-ink-muted">desde <%= l(@cash_session.opened_at, format: :short) %></p>
    <% else %>
      <p class="font-bold text-2xl text-danger">Fechado</p>
      <p class="text-xs text-ink-muted"><%= link_to "Abrir caixa", new_cash_session_path, class: "underline" %></p>
    <% end %>
  </div>

  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex items-center gap-2 text-ink-muted text-sm mb-1">
      <%= icon :clipboard, css_class: "size-4" %> Comandas abertas
    </div>
    <p class="font-bold text-2xl"><%= @open_orders_count %></p>
    <p class="text-xs text-ink-muted">mesas, balcão e delivery</p>
  </div>

  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex items-center gap-2 text-ink-muted text-sm mb-1">
      <%= icon :warning, css_class: "size-4" %> Estoque baixo
    </div>
    <p class="font-bold text-2xl <%= "text-danger" if @low_stock_count.positive? %>"><%= @low_stock_count %></p>
    <p class="text-xs text-ink-muted">
      <% if @low_stock_count.positive? && current_user_admin? %>
        <%= link_to "ver insumos", admin_ingredients_path, class: "underline" %>
      <% else %>
        insumo(s) no mínimo
      <% end %>
    </p>
  </div>
</div>

<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
  <%= link_to tables_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
    <p class="font-semibold flex items-center gap-2"><%= icon :tables, css_class: "size-5 text-primary-700" %> Mesas</p>
    <p class="text-ink-muted text-sm mt-1">Abrir comandas e acompanhar o salão</p>
  <% end %>

  <%= link_to balcao_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
    <p class="font-semibold flex items-center gap-2"><%= icon :balcao, css_class: "size-5 text-primary-700" %> Balcão</p>
    <p class="text-ink-muted text-sm mt-1">Ver vendas abertas e iniciar uma nova</p>
  <% end %>

  <%= link_to deliveries_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
    <p class="font-semibold flex items-center gap-2"><%= icon :delivery, css_class: "size-5 text-primary-700" %> Delivery</p>
    <p class="text-ink-muted text-sm mt-1">Pedidos e status de entrega</p>
  <% end %>

  <%= link_to cash_session_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
    <p class="font-semibold flex items-center gap-2"><%= icon :cash, css_class: "size-5 text-primary-700" %> Caixa</p>
    <p class="text-ink-muted text-sm mt-1">Abrir/fechar caixa, sangria e suprimento</p>
  <% end %>

  <%= link_to customers_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
    <p class="font-semibold flex items-center gap-2"><%= icon :customers, css_class: "size-5 text-primary-700" %> Clientes</p>
    <p class="text-ink-muted text-sm mt-1">Cadastro e fiado em aberto</p>
  <% end %>

  <%= link_to orders_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
    <p class="font-semibold flex items-center gap-2"><%= icon :sales, css_class: "size-5 text-primary-700" %> Vendas</p>
    <p class="text-ink-muted text-sm mt-1">Ver comandas do dia e cancelar</p>
  <% end %>

  <% if current_user_admin? %>
    <%= link_to admin_products_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
      <p class="font-semibold flex items-center gap-2"><%= icon :product, css_class: "size-5 text-primary-700" %> Cardápio</p>
      <p class="text-ink-muted text-sm mt-1">Categorias, produtos e ficha técnica</p>
    <% end %>

    <%= link_to admin_ingredients_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
      <p class="font-semibold flex items-center gap-2"><%= icon :ingredient, css_class: "size-5 text-primary-700" %> Insumos</p>
      <p class="text-ink-muted text-sm mt-1">Estoque e movimentações</p>
    <% end %>

    <%= link_to admin_reports_path, class: "bg-surface rounded-xl shadow-sm border border-gray-200 p-5 hover:border-primary-400 hover:bg-primary-50" do %>
      <p class="font-semibold flex items-center gap-2"><%= icon :report, css_class: "size-5 text-primary-700" %> Relatórios</p>
      <p class="text-ink-muted text-sm mt-1">Vendas, produtos e histórico de caixa</p>
    <% end %>
  <% end %>
</div>
