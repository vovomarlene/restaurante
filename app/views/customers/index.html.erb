<% content_for :title, "Clientes" %>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :customers, css_class: "size-6 text-primary-700" %> Clientes</h1>
  <div class="flex gap-3">
    <% if params[:fiado].present? %>
      <%= link_to "Mostrar todos", customers_path, class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted font-medium" %>
    <% else %>
      <%= link_to "Mostrar só com fiado em aberto", customers_path(fiado: 1), class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted font-medium" %>
    <% end %>
    <%= link_to "Novo cliente", new_customer_path, class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium" %>
  </div>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-2">Nome</th>
        <th class="px-4 py-2">Telefone</th>
        <th class="px-4 py-2">Saldo fiado</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @customers.empty? %>
        <tr><td class="px-4 py-4 text-ink-muted" colspan="4">Nenhum cliente encontrado.</td></tr>
      <% end %>
      <% @customers.each do |customer| %>
        <tr class="hover:bg-surface-muted transition-colors">
          <td class="px-4 py-2"><%= link_to customer.name, customer_path(customer), class: "text-primary-700 hover:underline" %></td>
          <td class="px-4 py-2"><%= customer.phone %></td>
          <td class="px-4 py-2 <%= "text-danger font-medium" if customer.fiado_balance.positive? %>">
            <%= number_to_currency(customer.fiado_balance, unit: "R$ ", separator: ",", delimiter: ".") %>
          </td>
          <td class="px-4 py-2 text-right">
            <%= link_to edit_customer_path(customer), class: "inline-flex items-center gap-1 text-primary-700 hover:underline" do %>
              <%= icon :edit, css_class: "size-4" %> Editar
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
