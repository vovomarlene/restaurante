<%= form_with model: customer, class: "space-y-4" do |form| %>
  <% if customer.errors.any? %>
    <div class="py-2 px-3 bg-red-50 text-red-700 rounded-lg text-sm">
      <%= customer.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nome", class: "block text-sm font-medium text-ink-muted mb-1" %>
    <%= form.text_field :name, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
  </div>

  <div>
    <%= form.label :phone, "Telefone", class: "block text-sm font-medium text-ink-muted mb-1" %>
    <%= form.text_field :phone, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
  </div>

  <div>
    <%= form.label :address, "Endereço", class: "block text-sm font-medium text-ink-muted mb-1" %>
    <%= form.text_area :address, rows: 2, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
  </div>

  <div>
    <%= form.label :notes, "Observações", class: "block text-sm font-medium text-ink-muted mb-1" %>
    <%= form.text_area :notes, rows: 2, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
  </div>

  <% unless customer.new_record? %>
    <div class="flex items-center gap-2">
      <%= form.check_box :active, class: "rounded border-gray-300" %>
      <%= form.label :active, "Ativo", class: "text-sm font-medium text-ink-muted" %>
    </div>
  <% end %>

  <div class="flex gap-3">
    <%= form.submit "Salvar", class: "rounded-md px-3.5 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancelar", customers_path, class: "rounded-md px-3.5 py-2 border border-gray-300 hover:bg-surface-muted" %>
  </div>
<% end %>
