<% content_for :title, "Vendas" %>

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
  <h1 class="font-bold text-2xl flex items-center gap-2.5"><%= icon :sales, css_class: "size-6 text-primary-700" %> Vendas</h1>

  <%= form_with url: orders_path, method: :get, class: "flex items-center gap-2" do |form| %>
    <%= form.label :date, "Dia", class: "text-sm text-ink-muted" %>
    <%= form.text_field :date, value: @date.strftime("%d/%m/%Y"), placeholder: "dd/mm/aaaa", pattern: "\\d{2}/\\d{2}/\\d{4}",
          class: "shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-1.5 text-sm w-28" %>

    <%= form.label :status, "Status", class: "text-sm text-ink-muted" %>
    <%= form.select :status, [["Todos", ""], ["Aberta", "aberto"], ["Fechada", "fechado"], ["Cancelada", "cancelado"]],
          { selected: params[:status] }, class: "shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-1.5 text-sm" %>

    <%= form.submit "Ver", class: "rounded-md px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium cursor-pointer" %>
  <% end %>
</div>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-ink-muted">
      <tr>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Horário</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Tipo</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Mesa / Cliente</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Total</th>
        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @orders.empty? %>
        <tr><td class="px-4 py-6 text-center text-ink-muted" colspan="6">Nenhuma venda neste dia.</td></tr>
      <% end %>
      <% @orders.each do |order| %>
        <tr class="hover:bg-surface-muted transition-colors <%= "opacity-60" if order.cancelado? %>">
          <td class="px-4 py-3"><%= l(order.opened_at, format: :short) %></td>
          <td class="px-4 py-3"><%= t("enums.order.order_type.#{order.order_type}") %></td>
          <td class="px-4 py-3">
            <% if order.mesa? %>
              <%= order.dining_table ? "Mesa #{order.dining_table.number}" : "Comanda ##{order.id}" %>
            <% elsif order.delivery? %>
              <%= order.customer_name %>
            <% else %>
              —
            <% end %>
          </td>
          <td class="px-4 py-3 font-medium"><%= number_to_currency(order.cancelado? ? order.total_before_cancellation : order.total, unit: "R$ ", separator: ",", delimiter: ".") %></td>
          <td class="px-4 py-3">
            <% badge_class = { "aberto" => "bg-blue-100 text-blue-800", "fechado" => "bg-green-100 text-green-800", "cancelado" => "bg-red-100 text-red-800" }[order.status] %>
            <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
              <%= { "aberto" => "Aberta", "fechado" => "Fechada", "cancelado" => "Cancelada" }[order.status] %>
            </span>
          </td>
          <td class="px-4 py-3 text-right space-x-1">
            <% if order.aberto? %>
              <%= link_to order_path(order), class: "inline-flex items-center gap-1 text-primary-700 hover:bg-primary-50 rounded-md px-2 py-1" do %>
                <%= icon :eye, css_class: "size-4" %> Ver comanda
              <% end %>
              <% if order.requires_refund? %>
                <% if current_user_admin? %>
                  <%= link_to cancel_order_path(order), class: "inline-flex items-center gap-1 text-danger hover:bg-red-50 rounded-md px-2 py-1" do %>
                    <%= icon :trash, css_class: "size-4" %> Estornar
                  <% end %>
                <% end %>
              <% else %>
                <%= link_to cancel_order_path(order), class: "inline-flex items-center gap-1 text-danger hover:bg-red-50 rounded-md px-2 py-1" do %>
                  <%= icon :trash, css_class: "size-4" %> Cancelar
                <% end %>
              <% end %>
            <% elsif order.fechado? %>
              <%= link_to receipt_order_path(order), class: "inline-flex items-center gap-1 text-primary-700 hover:bg-primary-50 rounded-md px-2 py-1" do %>
                <%= icon :clipboard, css_class: "size-4" %> Recibo
              <% end %>
              <% if current_user_admin? %>
                <%= link_to cancel_order_path(order), class: "inline-flex items-center gap-1 text-danger hover:bg-red-50 rounded-md px-2 py-1" do %>
                  <%= icon :trash, css_class: "size-4" %> Cancelar venda
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pagination", pagy: @pagy %>
</div>
