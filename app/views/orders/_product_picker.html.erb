<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-4">
  <h2 class="font-semibold text-lg mb-4">Cardápio</h2>

  <% categories.each do |category| %>
    <% active_products = category.products.select(&:active?) %>
    <% next if active_products.empty? %>

    <div class="mt-6 first:mt-0">
      <h3 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-primary-700 mb-3">
        <span><%= category.name %></span>
        <span class="h-px flex-1 bg-gray-200"></span>
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
        <% active_products.each do |product| %>
          <%= button_to order_order_items_path(order), params: { order_item: { product_id: product.id, quantity: 1 } }, method: :post,
                class: "text-left rounded-lg border border-gray-200 bg-surface hover:border-primary-400 hover:bg-primary-50 hover:shadow-sm transition-all px-3 py-2.5 text-sm cursor-pointer" do %>
            <span class="block font-medium leading-snug"><%= product.name %></span>
            <span class="block text-primary-700 text-xs font-medium mt-1"><%= number_to_currency(product.price, unit: "R$", separator: ",", delimiter: ".") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
