<% visible_categories = categories.filter_map { |category|
     active_products = category.products.select(&:active?)
     [ category, active_products ] unless active_products.empty?
   } %>

<div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-4" data-controller="product-tabs">
  <h2 class="font-semibold text-lg mb-3">Cardápio</h2>

  <% if visible_categories.empty? %>
    <p class="text-ink-muted text-sm">Nenhum produto disponível.</p>
  <% else %>
    <div class="flex gap-2 overflow-x-auto pb-1 mb-4">
      <% visible_categories.each_with_index do |(category, _), index| %>
        <button type="button"
                class="shrink-0 px-4 py-2 rounded-full text-sm font-medium border transition-colors cursor-pointer <%= index.zero? ? "bg-primary-600 text-white border-primary-600" : "bg-surface border-gray-200 text-ink-muted hover:bg-surface-muted" %>"
                data-action="product-tabs#show" data-product-tabs-target="tab" data-category="<%= category.id %>">
          <%= category.name %>
        </button>
      <% end %>
    </div>

    <% visible_categories.each_with_index do |(category, active_products), index| %>
      <div data-product-tabs-target="panel" data-category="<%= category.id %>" class="<%= "hidden" unless index.zero? %>">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
          <% active_products.each do |product| %>
            <%= button_to order_order_items_path(order), params: { order_item: { product_id: product.id, quantity: 1 } }, method: :post,
                  class: "text-left rounded-lg border border-gray-200 bg-surface hover:border-primary-400 hover:bg-primary-50 hover:shadow-sm active:scale-[0.97] transition-all px-3 py-3.5 text-sm cursor-pointer" do %>
              <span class="block font-medium leading-snug"><%= product.name %></span>
              <span class="block text-primary-700 text-sm font-semibold mt-1.5"><%= number_to_currency(product.price, unit: "R$", separator: ",", delimiter: ".") %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
