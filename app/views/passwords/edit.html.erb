<div class="mx-auto w-full max-w-sm mt-16">
  <h1 class="font-bold text-3xl text-center mb-8 text-primary-700"><%= t("app.name") %></h1>

  <div class="bg-surface rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-xl mb-6">Nova senha</h2>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, "Nova senha", class: "block text-sm font-medium text-ink-muted mb-1" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
      </div>

      <div>
        <%= form.label :password_confirmation, "Confirme a nova senha", class: "block text-sm font-medium text-ink-muted mb-1" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-300 focus:outline-primary-600 px-3 py-2 w-full" %>
      </div>

      <%= form.submit "Salvar", class: "w-full text-center rounded-md px-3.5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white font-medium cursor-pointer" %>
    <% end %>
  </div>
</div>
